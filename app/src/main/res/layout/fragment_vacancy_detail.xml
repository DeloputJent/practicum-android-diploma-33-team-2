<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">
    <ImageView
        android:id="@+id/imageMask"
        android:layout_width="46dp"
        android:layout_height="10dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginEnd="8dp"
        android:layout_marginTop="7dp"
        app:srcCompat="@drawable/ic_mask_46dp"/>
    <ImageButton
        android:id="@+id/buttonGoBack"
        android:layout_width="48dp"
        android:layout_height="48dp"
        app:srcCompat="@drawable/ic_arrow_back_24dp"
        android:background="@null"
        android:scaleType="center"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginTop="32dp"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginStart="4dp"/>
    <TextView
        android:id="@+id/textTitle"
        android:layout_width="192dp"
        android:layout_height="26dp"
        android:text="@string/vacancy_vacancy"
        style="@style/Medium_YS_Display_22sp_black"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginStart="56dp"
        android:layout_marginTop="43dp"/>
    <ImageButton
        android:id="@+id/buttonShareVacancy"
        android:layout_width="48dp"
        android:layout_height="48dp"
        app:srcCompat="@drawable/ic_sharing_24dp"
        android:background="@null"
        android:scaleType="center"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginTop="32dp"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginEnd="60dp"/>
    <ImageButton
        android:id="@+id/buttonAddToFavorite"
        android:layout_width="48dp"
        android:layout_height="48dp"
        app:srcCompat="@drawable/ic_favorites_off__24dp"
        android:background="@null"
        android:scaleType="center"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginTop="32dp"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginEnd="8dp"/>

    <androidx.constraintlayout.widget.Guideline
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:id="@+id/leftBorder"
        android:orientation="vertical"
        app:layout_constraintGuide_begin="16dp"/>
    <androidx.constraintlayout.widget.Guideline
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:id="@+id/rightBorder"
        android:orientation="vertical"
        app:layout_constraintGuide_end="16dp"/>

    <TextView
        android:id="@+id/textVacancyName"
        android:layout_width="0dp"
        android:layout_height="38dp"
        tools:text="Android-разработчик"
        style="@style/Bold_YS_Display_32sp_black"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginTop="112dp"
        app:layout_constraintStart_toStartOf="@id/leftBorder"
        app:layout_constraintEnd_toEndOf="@id/rightBorder"/>
    <TextView
        android:id="@+id/textSalary"
        android:layout_width="0dp"
        android:layout_height="26dp"
        tools:text="от 100 000 ₽"
        style="@style/Medium_YS_Display_22sp_black"
        app:layout_constraintTop_toBottomOf="@id/textVacancyName"
        app:layout_constraintStart_toStartOf="@id/leftBorder"
        app:layout_constraintEnd_toEndOf="@id/rightBorder"/>
    <ImageView
        android:id="@+id/cardField"
        android:layout_width="0dp"
        android:layout_height="80dp"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginTop="204dp"
        app:layout_constraintStart_toStartOf="@id/leftBorder"
        app:layout_constraintEnd_toEndOf="@id/rightBorder"
        android:background="@drawable/rounded_field_gray_12dp"/>
    <ImageView
        android:id="@+id/imageLogo"
        android:layout_width="48dp"
        android:layout_height="48dp"
        app:layout_constraintTop_toTopOf="@id/cardField"
        android:layout_marginTop="16dp"
        app:layout_constraintStart_toStartOf="@id/cardField"
        android:layout_marginStart="16dp"
        android:src="@drawable/ic_placeholder_logo_48dp"
        android:background="@drawable/rounded_field_gray_12dp"/>
    <TextView
        android:id="@+id/text_employer"
        android:layout_width="0dp"
        android:layout_height="26dp"
        style="@style/Medium_YS_Display_22sp_black"
        tools:text="Еда"
        app:layout_constraintTop_toTopOf="@id/cardField"
        android:layout_marginTop="16dp"
        app:layout_constraintStart_toStartOf="@id/cardField"
        android:layout_marginStart="72dp"
        app:layout_constraintEnd_toEndOf="@id/cardField"
        android:layout_marginEnd="16dp"/>
    <TextView
        android:id="@+id/text_address"
        android:layout_width="0dp"
        android:layout_height="19dp"
        style="@style/Regular_YS_Display_16sp_black"
        tools:text="Москва"
        app:layout_constraintTop_toBottomOf="@id/text_employer"
        app:layout_constraintStart_toStartOf="@id/cardField"
        android:layout_marginStart="72dp"
        app:layout_constraintEnd_toEndOf="@id/cardField"
        android:layout_marginEnd="16dp"/>
    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="@id/leftBorder"
        app:layout_constraintEnd_toEndOf="@id/rightBorder"
        app:layout_constraintTop_toBottomOf="@id/cardField"
        android:layout_marginTop="24dp">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <TextView
                android:id="@+id/text_experience_title"
                android:layout_width="0dp"
                android:layout_height="19sp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                style="@style/Medium_YS_Display_16sp_black"
                android:text="@string/vacancy_experience"/>
            <TextView
                android:id="@+id/text_experience"
                android:layout_width="0dp"
                android:layout_height="19sp"
                app:layout_constraintTop_toBottomOf="@id/text_experience_title"
                app:layout_constraintStart_toStartOf="parent"
                style="@style/Regular_YS_Display_16sp_black"
                tools:text="От 1 года до 3 лет"/>
            <TextView
                android:id="@+id/text_schedule"
                android:layout_width="0dp"
                android:layout_height="19sp"
                app:layout_constraintTop_toBottomOf="@id/text_experience"
                android:layout_marginTop="8dp"
                app:layout_constraintStart_toStartOf="parent"
                style="@style/Regular_YS_Display_16sp_black"
                tools:text="Полная занятость, Удаленная работа"/>

            <WebView
                android:id="@+id/vacancy_description"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toBottomOf="@id/text_schedule"
                android:layout_marginTop="32dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>





        </androidx.constraintlayout.widget.ConstraintLayout>


    </androidx.core.widget.NestedScrollView>



</androidx.constraintlayout.widget.ConstraintLayout>
