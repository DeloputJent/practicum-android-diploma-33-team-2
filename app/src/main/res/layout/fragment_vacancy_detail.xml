<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">
    <ImageView
        android:id="@+id/imageMask"
        android:layout_width="46dp"
        android:layout_height="10dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginEnd="8dp"
        android:layout_marginTop="7dp"
        app:srcCompat="@drawable/ic_mask_46dp"/>
    <ImageButton
        android:id="@+id/buttonGoBack"
        android:layout_width="48dp"
        android:layout_height="48dp"
        app:srcCompat="@drawable/ic_arrow_back_24dp"
        android:background="@null"
        android:scaleType="center"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginTop="32dp"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginStart="4dp"/>
    <TextView
        android:id="@+id/textTitle"
        android:layout_width="192dp"
        android:layout_height="26dp"
        android:text="@string/vacancy_vacancy"
        style="@style/Medium_YS_Display_22sp_black"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginStart="56dp"
        android:layout_marginTop="43dp"/>
    <ImageButton
        android:id="@+id/buttonShareVacancy"
        android:layout_width="48dp"
        android:layout_height="48dp"
        app:srcCompat="@drawable/ic_sharing_24dp"
        android:background="@null"
        android:scaleType="center"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginTop="32dp"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginEnd="60dp"/>
    <ImageButton
        android:id="@+id/buttonAddToFavorite"
        android:layout_width="48dp"
        android:layout_height="48dp"
        app:srcCompat="@drawable/ic_favorites_off__24dp"
        android:background="@null"
        android:scaleType="center"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginTop="32dp"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginEnd="8dp"/>

    <TextView
        android:id="@+id/textVacancyName"
        android:layout_width="0dp"
        android:layout_height="38dp"
        tools:text="Android-разработчик"
        style="@style/Bold_YS_Display_32sp_black"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginTop="112dp"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginStart="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginEnd="16dp"/>
    <TextView
        android:id="@+id/textSalary"
        android:layout_width="0dp"
        android:layout_height="26dp"
        tools:text="от 100 000 ₽"
        style="@style/Medium_YS_Display_22sp_black"
        app:layout_constraintTop_toBottomOf="@id/textVacancyName"
        app:layout_constraintStart_toStartOf="@id/textVacancyName"
        app:layout_constraintEnd_toEndOf="@id/textVacancyName"/>
    <ImageView
        android:id="@+id/cardField"
        android:layout_width="0dp"
        android:layout_height="80dp"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginTop="204dp"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginStart="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginEnd="16dp"
        android:background="@drawable/rounded_field_gray_12dp"/>
    <ImageView
        android:id="@+id/imageLogo"
        android:layout_width="48dp"
        android:layout_height="48dp"
        app:layout_constraintTop_toTopOf="@id/cardField"
        android:layout_marginTop="16dp"
        app:layout_constraintStart_toStartOf="@id/cardField"
        android:layout_marginStart="16dp"
        android:src="@drawable/ic_placeholder_logo_48dp"
        android:background="@drawable/rounded_field_gray_12dp"/>
    <TextView
        android:id="@+id/textCompanyName"
        android:layout_width="0dp"
        android:layout_height="26dp"
        style="@style/Medium_YS_Display_22sp_black"
        tools:text="Еда"
        app:layout_constraintTop_toTopOf="@id/cardField"
        android:layout_marginTop="16dp"
        app:layout_constraintStart_toStartOf="@id/cardField"
        android:layout_marginStart="72dp"
        app:layout_constraintEnd_toEndOf="@id/cardField"
        android:layout_marginEnd="16dp"/>
    <TextView
        android:id="@+id/textCity"
        android:layout_width="0dp"
        android:layout_height="19dp"
        style="@style/Regular_YS_Display_16sp_black"
        tools:text="Москва"
        app:layout_constraintTop_toBottomOf="@id/textCompanyName"
        app:layout_constraintStart_toStartOf="@id/cardField"
        android:layout_marginStart="72dp"
        app:layout_constraintEnd_toEndOf="@id/cardField"
        android:layout_marginEnd="16dp"/>

</androidx.constraintlayout.widget.ConstraintLayout>
