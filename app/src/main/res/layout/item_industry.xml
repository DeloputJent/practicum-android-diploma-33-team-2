<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="16dp"
    android:paddingTop="6dp"
    android:paddingEnd="4dp"
    android:paddingBottom="6dp">
    <TextView
        android:id="@+id/textIndustryName"
        style="@style/Regular_YS_Display_16sp_black"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:maxLines="2"
        android:gravity="center_vertical"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/buttonSelectThisIndustry"
        android:layout_marginEnd="4dp"
        tools:text="Авиационная, вертолетная и аэрокосмическая промышленность" />
    <ImageButton
        android:id="@+id/buttonSelectThisIndustry"
        android:layout_width="48dp"
        android:layout_height="48dp"
        app:srcCompat="@drawable/ic_radio_button_off_24dp"
        android:background="@null"
        android:scaleType="center"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
