<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <ImageView
        android:id="@+id/imageMask"
        android:layout_width="46dp"
        android:layout_height="10dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginEnd="8dp"
        android:layout_marginTop="7dp"
        app:srcCompat="@drawable/ic_mask_46dp"/>
    <ImageButton
        android:id="@+id/buttonGoBack"
        android:layout_width="48dp"
        android:layout_height="48dp"
        app:srcCompat="@drawable/ic_arrow_back_24dp"
        android:background="@null"
        android:scaleType="center"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginTop="32dp"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginStart="4dp"/>
    <TextView
        android:id="@+id/textScreenTitle"
        android:layout_width="wrap_content"
        android:layout_height="26dp"
        android:text="@string/filter_filter_settings"
        style="@style/Medium_YS_Display_22sp_black"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginStart="56dp"
        android:layout_marginTop="43dp"/>
    <androidx.constraintlayout.widget.Group
        android:layout_height="wrap_content"
        android:layout_width="wrap_content"
        android:id="@+id/viewButtonSelectWorkPlace"
        app:constraint_referenced_ids="textHintSelectWorkPlace,imageWorkPlaceGoClear"/>
        <TextView
            android:id="@+id/textHintSelectWorkPlace"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            app:layout_constraintTop_toTopOf="parent"
            android:layout_marginTop="104dp"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginStart="16dp"
            style="@style/Regular_YS_Display_16sp_black"
            android:gravity="center_vertical||start"
            android:hint="@string/filter_job_location"
            android:textColorHint="@color/HH_Gray"
            android:background="@null"
            android:scaleType="center"/>
        <ImageView
            android:id="@+id/imageWorkPlaceGoClear"
            android:layout_width="48dp"
            android:layout_height="48dp"
            app:srcCompat="@drawable/ic_arrow_forward_24dp"
            android:background="@null"
            android:scaleType="center"
            app:layout_constraintTop_toTopOf="parent"
            android:layout_marginTop="110dp"
            app:layout_constraintStart_toEndOf="id/buttonSelectWorkPlace"
            android:layout_marginStart="4dp"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginEnd="4dp"/>

</androidx.constraintlayout.widget.ConstraintLayout>
