<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">
    <ImageView
        android:id="@+id/imageMask"
        android:layout_width="46dp"
        android:layout_height="10dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginEnd="8dp"
        android:layout_marginTop="7dp"
        app:srcCompat="@drawable/ic_mask_46dp"/>
    <ImageButton
        android:id="@+id/buttonGoBack"
        android:layout_width="48dp"
        android:layout_height="48dp"
        app:srcCompat="@drawable/ic_arrow_back_24dp"
        android:background="@null"
        android:scaleType="center"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginTop="32dp"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginStart="4dp"/>
    <TextView
        android:id="@+id/textScreenTitle"
        android:layout_width="wrap_content"
        android:layout_height="26dp"
        android:text="@string/filter_filter_settings"
        style="@style/Medium_YS_Display_22sp_black"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginStart="56dp"
        android:layout_marginTop="43dp"/>
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/buttonAddWorkPlaceFilter"
        android:layout_width="0dp"
        android:layout_height="60dp"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginTop="104dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/imageWorkPlaceGoClear"
        android:background="@null"/>
    <TextView
        android:id="@+id/textHintSelectWorkPlace"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginTop="104dp"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginStart="16dp"
        style="@style/Regular_YS_Display_16sp_black"
        android:gravity="center_vertical"
        android:text="@string/filter_job_location"
        android:textColor="@color/HH_Gray"
        android:background="@null"
        android:scaleType="center"
        android:clickable="true"/>
    <androidx.constraintlayout.widget.Group
        android:layout_height="wrap_content"
        android:layout_width="wrap_content"
        android:id="@+id/viewButtonSelectWorkPlace"
        android:visibility="gone"
        app:constraint_referenced_ids="textHintWorkPlace,textSelectedWorkPlace"/>
    <TextView
        android:id="@+id/textHintWorkPlace"
        android:layout_width="match_parent"
        android:layout_height="16dp"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginTop="118dp"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginStart="16dp"
        app:layout_constraintEnd_toStartOf="@id/imageWorkPlaceGoClear"
        style="@style/Regular_YS_Display_12sp_black"
        android:gravity="start"
        tools:text="Место работы"
        android:background="@null"
        android:scaleType="center"/>
    <TextView
        android:id="@+id/textSelectedWorkPlace"
        style="@style/Regular_YS_Display_16sp_black"
        android:layout_width="match_parent"
        android:layout_height="19dp"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginStart="16dp"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginTop="133dp"
        android:background="@null"
        android:gravity="center_vertical"
        tools:text="Россия, Москва"
        android:scaleType="center"
        android:textColorHint="@color/HH_Gray"
        app:layout_constraintEnd_toStartOf="@id/imageWorkPlaceGoClear"/>
    <ImageView
            android:id="@+id/imageWorkPlaceGoClear"
            android:layout_width="48dp"
            android:layout_height="48dp"
            app:srcCompat="@drawable/ic_arrow_forward_24dp"
            android:background="@null"
            android:scaleType="center"
            app:layout_constraintTop_toTopOf="parent"
            android:layout_marginTop="110dp"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginEnd="4dp"/>
    <TextView
        android:id="@+id/textHintSelectIndustry"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginTop="164dp"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginStart="16dp"
        style="@style/Regular_YS_Display_16sp_black"
        android:gravity="center_vertical"
        android:text="@string/filter_industry"
        android:textColor="@color/HH_Gray"
        android:background="@null"
        android:scaleType="center"
        android:clickable="true"/>
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/buttonAddIndustryFilter"
        android:layout_width="0dp"
        android:layout_height="60dp"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginTop="164dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/imageIndustryGoClear"
        android:background="@null"/>
    <androidx.constraintlayout.widget.Group
        android:layout_height="wrap_content"
        android:layout_width="wrap_content"
        android:id="@+id/viewButtonSelectIndustry"
        android:visibility="visible"
        app:constraint_referenced_ids="textHintIndustry,textSelectedIndustry"/>
    <TextView
        android:id="@+id/textHintIndustry"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginTop="177dp"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginStart="16dp"
        app:layout_constraintBottom_toTopOf="@id/textSelectedIndustry"
        app:layout_constraintEnd_toStartOf="@id/imageIndustryGoClear"
        style="@style/Regular_YS_Display_12sp_black"
        android:gravity="start"
        android:text="@string/filter_industry"
        android:background="@null"/>
    <TextView
        android:id="@+id/textSelectedIndustry"
        android:layout_width="0dp"
        android:layout_height="19dp"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginStart="16dp"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginTop="193dp"
        app:layout_constraintEnd_toStartOf="@id/imageIndustryGoClear"
        style="@style/Regular_YS_Display_16sp_black"
        android:background="@null"
        android:gravity="start"
        android:ellipsize="end"
        tools:text="IT"
        android:textColorHint="@color/HH_Gray"/>
    <ImageView
        android:id="@+id/imageIndustryGoClear"
        android:layout_width="48dp"
        android:layout_height="48dp"
        app:srcCompat="@drawable/ic_arrow_forward_24dp"
        android:background="@null"
        android:scaleType="center"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginTop="170dp"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginEnd="4dp"/>
    <EditText
        android:id="@+id/editWantedSalary"
        android:layout_width="0dp"
        android:layout_height="51dp"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginTop="248dp"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginStart="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginEnd="16dp"
        android:background="@drawable/rounded_field_gray_12dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="8dp"
        android:paddingTop="24dp"
        android:hint="@string/filter_enter_the_amount"
        android:textColorHint="@color/HH_Gray"
        style="@style/Regular_YS_Display_16sp_black"
        android:singleLine="true"
        android:textCursorDrawable="@drawable/ic_cursor_22dp"
        android:imeOptions="actionDone"
        android:inputType="numberDecimal"
        android:lines="1"
        android:maxLength="50"/>
    <TextView
        android:id="@+id/textHintWantedSalary"
        style="@style/Regular_YS_Display_12sp_black"
        android:layout_width="match_parent"
        android:layout_height="16dp"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginStart="32dp"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginTop="256dp"
        android:background="@null"
        android:text="@string/filter_expected_salary"
        android:textColor="@color/HH_Gray"/>
    <ImageButton
        android:id="@+id/buttonClearSalaryInput"
        android:layout_width="48dp"
        android:layout_height="48dp"
        app:srcCompat="@drawable/ic_close_24dp"
        android:background="@null"
        android:scaleType="center"
        app:layout_constraintTop_toTopOf="@id/editWantedSalary"
        android:layout_marginTop="2dp"
        app:layout_constraintEnd_toEndOf="@id/editWantedSalary"
        android:layout_marginEnd="4dp"
        android:visibility="gone"
        tools:visibility="visible"/>
    <TextView
        android:id="@+id/textOnlyWithSalaryCheckBox"
        style="@style/Regular_YS_Display_16sp_black"
        android:layout_width="0dp"
        android:layout_height="60dp"
        app:drawableEndCompat="@drawable/ic_check_box_off__24dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginTop="323dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:background="@null"
        android:drawablePadding="19dp"
        android:gravity="center_vertical"
        android:text="@string/filter_do_not_show_without_a_salary"
        android:clickable="true"/>
    <TextView
        android:id="@+id/buttonApplyFilterParameters"
        android:layout_width="0dp"
        android:layout_height="59dp"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginBottom="91dp"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginEnd="17dp"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginStart="17dp"
        android:background="@drawable/rounded_field_blue_12dp"
        android:text="@string/filter_apply"
        android:textAllCaps="false"
        style="@style/Medium_YS_Display_16sp_black"
        android:textColor="@color/HH_White"
        android:gravity="center"
        android:visibility="gone"
        tools:visibility="visible"/>
    <TextView
        android:id="@+id/buttonDropFilterParameters"
        android:layout_width="0dp"
        android:layout_height="59dp"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginBottom="24dp"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginEnd="17dp"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginStart="17dp"
        android:text="@string/filter_reset"
        android:textAllCaps="false"
        style="@style/Medium_YS_Display_16sp_black"
        android:textColor="@color/HH_Red"
        android:gravity="center"
        android:visibility="gone"
        tools:visibility="visible"/>
</androidx.constraintlayout.widget.ConstraintLayout>
